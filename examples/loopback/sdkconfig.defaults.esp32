# Classic ESP32 GPIO defaults for the loopback example.
#
# Chosen to avoid UART0 (GPIO1/GPIO3) and the usual SPI-flash pin range
# (GPIO6-11 on most modules). Adjust if your board uses these pins for
# something else.

CONFIG_LOOPBACK_MIC_GPIO_BCK=12
CONFIG_LOOPBACK_MIC_GPIO_WS=13
CONFIG_LOOPBACK_MIC_GPIO_DATA=14

CONFIG_LOOPBACK_SPK_GPIO_BCK=16
CONFIG_LOOPBACK_SPK_GPIO_WS=17
CONFIG_LOOPBACK_SPK_GPIO_DATA=18
